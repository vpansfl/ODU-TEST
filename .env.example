# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채워 주세요.
# 값은 Supabase 대시보드 > Project Settings > API Keys 에서 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 영화 검색용 API 키 (서버에서만 사용 — 앞에 NEXT_PUBLIC_ 을 붙이지 마세요)
# TMDB: https://www.themoviedb.org/settings/api 의 "API 키" (v3)
TMDB_API_KEY=your_tmdb_api_key
# KOBIS: https://www.kobis.or.kr/kobisopenapi 에서 발급받은 키
KOBIS_API_KEY=your_kobis_api_key
